# ---------------------------------------------------------------------------
# Configuration de 1% Better, copiée en `.env.local` pour le développement.
#
# Aucune de ces valeurs n'est secrète : toutes finissent dans le code livré au
# navigateur. Les identifiants d'Apple et de Google sont publics par
# construction ; les mentions légales sont destinées à être lues.
#
# En production, ces variables se renseignent dans les *Variables* du dépôt
# (Settings → Secrets and variables → Actions → Variables), pas dans les
# secrets — voir `.github/workflows/pages.yml`.
# ---------------------------------------------------------------------------

# --- Fournisseurs d'identité (facultatif) ---------------------------------
# Absents, les boutons Apple et Google sont désactivés et l'écran le dit.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=

# --- Mentions légales obligatoires ----------------------------------------
# Tant qu'une de ces valeurs manque, l'écran « Informations légales » affiche à
# sa place le nom de la mention et le texte de loi qui l'impose, et annonce que
# le service n'est pas publiable. L'application n'invente aucune identité.
VITE_LEGAL_NAME=
VITE_LEGAL_FORM=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REGISTRATION=
VITE_LEGAL_DIRECTOR=
VITE_LEGAL_EMAIL=
VITE_LEGAL_HOST_NAME=
VITE_LEGAL_HOST_ADDRESS=
VITE_LEGAL_PRIVACY_EMAIL=
VITE_LEGAL_MEDIATOR=
VITE_LEGAL_MEDIATOR_URL=
VITE_LEGAL_SITE_URL=

# --- Mentions recommandées -------------------------------------------------
# Obligatoires seulement dans certains cas : TVA si assujetti, capital pour une
# société, téléphone pour un service payant.
VITE_LEGAL_VAT=
VITE_LEGAL_CAPITAL=
VITE_LEGAL_PHONE=
VITE_LEGAL_HOST_PHONE=
